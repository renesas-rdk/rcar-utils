# PREEMPT_RT variant fragment for the R-Car V4H Sparrow Hawk.
#
# Merged by build_kernel.sh on top of sparrow_hawk_defconfig +
# sparrow_hawk.config when KERNEL_VARIANT=preempt-rt. It is concatenated
# *after* the CONFIG_LOCALVERSION lines that mk_config_merged appends, so the
# CONFIG_LOCALVERSION below is the one that wins ("last assignment wins") and
# the kernel release becomes <version>-arm64-renesas-rt instead of the stock
# <version>-arm64-renesas. That distinct release string is what keeps the two
# kernels' /usr/lib/modules/<release> trees from colliding.
#
# Keep the suffix free of underscores: it becomes the Debian package name and
# version, and dpkg rejects "_" in a version field.

# PREEMPT_RT kernel overrides
CONFIG_EXPERT=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_RT=y
CONFIG_PREEMPT_BUILD=y
CONFIG_PREEMPTION=y
CONFIG_PROVE_LOCKING=n
CONFIG_ARCH_SUPPORTS_RT=y
CONFIG_LOCALVERSION="-arm64-renesas-rt"
CONFIG_LOCALVERSION_AUTO=n

# Disable conflicting preemption modes
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT_DYNAMIC is not set
# CONFIG_PREEMPT_LAZY is not set

CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_REDUCED=y
# CONFIG_SCHED_DEBUG is not set

# Disable debug overhead that adds latency
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_DEBUG_RT_MUTEXES is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_WW_MUTEX_SLOWPATH is not set
# CONFIG_LOCKDEP is not set

# ---------------------------------------------------------------------------
# Pin back what CONFIG_EXPERT unhides
# ---------------------------------------------------------------------------
# PREEMPT_RT depends on EXPERT, and a number of unrelated symbols are declared
# "default y if !EXPERT". Turning EXPERT on therefore silently changes them,
# which has nothing to do with preemption:
#
#   MEDIA_SUPPORT_FILTER  y -> n, unhiding the whole media/DVB menu and adding
#                         ~116 frontend and tuner modules to the build
#   HID_* / INPUT_FF_MEMLESS
#                         y -> n, dropping the USB keyboard and mouse quirk
#                         drivers the board actually uses
#
# Restore the values the stock sparrow_hawk configuration produces, so the only
# difference between this kernel and the stock one is the preemption model.
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_HID_A4TECH=y
CONFIG_HID_APPLE=y
CONFIG_HID_BELKIN=y
CONFIG_HID_CHERRY=y
CONFIG_HID_CHICONY=y
CONFIG_HID_CYPRESS=y
CONFIG_HID_EZKEY=y
CONFIG_HID_ITE=y
CONFIG_HID_KENSINGTON=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_MONTEREY=y
CONFIG_HID_REDRAGON=y
